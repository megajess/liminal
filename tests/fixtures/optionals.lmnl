; Optional types, nil propagation, and nil operators

; Optional var
(var user-name: String? nil)

; Non-optional var with deferred init
(var result: Int)
(if true
  (set result 42)
  :else (set result 0))

; Nil coalescing
(func display-name: String [name: String?]
  (?? name "Anonymous"))

; Nil unwrap block — :is-nil branch is optional
(func safe-divide: Int [a: Int b: Int?]
  (?
    (local [divisor (ensure-nonzero b)]
      (/ a divisor))
    :is-nil
    (log "b was nil, returning 0")
    0))

; Nil unwrap without fallback — just bail if nil
(func process: Void [data: Data?]
  (?
    (do
      (validate data)
      (save data))))

; Optional chaining via nil propagation
(func get-city: String? [user: User?]
  user:address:city)

; Optional param with default
(func log-message: Void [
  _ message: String
  level: (String "info")]
  (log "{level}: {message}"))
